{% extends "base.html.j2" %}
{% block nav %}<a href="../../index.html">runs</a> · ideas board{% endblock %}
{% block content %}
<h1>Ideas board — {{ as_of }}</h1>
<p class="sub">{{ n_scored }} names scored in {{ regions|join(", ") }} · preset <b>{{ preset }}</b> · top {{ top }} shown by Idea Strength · sort and filter with the controls below · every reason cites its spec rule</p>
<div class="strip card">
  {% for k, v in macro.items() %}<span>{{ k }}: <b>{{ v }}</b></span>{% endfor %}
  <span class="muted">macro as of formation date (FRED, point-in-time)</span>
</div>
{% if changes %}
<div class="card" style="border-left:4px solid var(--s3)"><b>What changed since the last run</b> <span class="muted small">({{ changes.prev_as_of }} → {{ changes.cur_as_of }})</span>
  {% if changes.unchanged %}<div class="small">Same book, same sector calls.</div>{% else %}
  <div class="small">{% if changes.entered %}<b>New in the book:</b> {{ changes.entered|join(', ') }} · {% endif %}{% if changes.left %}<b>Dropped:</b> {{ changes.left|join(', ') }} · {% endif %}{% if changes.actions %}<b>Action changes:</b> {{ changes.actions|join('; ') }}{% endif %}</div>
  <div class="small">{% if changes.stances %}<b>Sector stance flips:</b> {{ changes.stances|join('; ') }} · {% endif %}{% if changes.cycles %}<b>Cycle phase:</b> {{ changes.cycles|join('; ') }}{% endif %}</div>
  <div class="small muted">{% if changes.moves %}Biggest strength moves: {{ changes.moves|join(' · ') }}{% endif %}{% if changes.kelly %} · Kelly size changes: {{ changes.kelly|join('; ') }}{% endif %}</div>{% endif %}
</div>
{% endif %}
{% if sector_calls %}
<h2 style="margin-top:14px">Stage 1 — the sector call (R-23 / F-39; theme sectors from config/sectors.yaml, AI split by value-chain layer)</h2>
<div class="sector-grid">
{% for s in sector_calls %}<div class="card sector-card">
  <div class="sector-head"><b>{{ s.label }}</b> <span class="badge {{ 'buy' if s.stance=='overweight' else ('excluded' if s.stance in ('avoid','underweight') else '') }}">{{ s.stance }}</span> <span class="muted small">score {{ '%.0f'|format(s.score) if s.score is not none else '–' }} · {{ s.n_members }} members · {{ s.slots }} slots</span></div>
  {% if s.bet %}<div class="small"><b>Bet:</b> <span class="{{ 'reason-pos' if s.bet.active_bet_pp > 0.5 else ('reason-neg' if s.bet.active_bet_pp < -0.5 else '') }}">{{ '%+.1f pp'|format(s.bet.active_bet_pp) }}</span> → {{ '%.1f%%'|format(s.bet.recommended_weight*100) }} vs {{ '%.1f%%'|format(s.bet.market_weight*100) }} market weight{% if s.bet.kelly_implied_weight %} · picks' Kelly {{ '%.0f%%'|format(s.bet.kelly_implied_weight*100) }}{% endif %}</div>
  {% if s.bet.cycle %}<div class="small muted">Cycle: {{ s.bet.cycle.phase }} — {{ s.bet.cycle.theme }} in {{ '%.0f%%'|format(s.bet.cycle.breadth_now) }} of calls ({{ s.bet.cycle.quarter }}), peak {{ '%.0f%%'|format(s.bet.cycle.breadth_peak) }}, {{ s.bet.cycle.trend }}{% if s.bet.cycle.cycle_started %}, since {{ s.bet.cycle.cycle_started }}{% endif %}</div>{% endif %}{% endif %}
  <div class="small muted">{{ STANCE_WORDS.get(s.stance, s.stance) }}.</div>
  {% if s.cycle_read %}<div class="small"><b>Commodity cycle:</b> {{ s.cycle_read.verdict }}</div>{% endif %}
  {% if s.danoff %}<div class="small"><b>Danoff:</b> {{ s.danoff.verdict[12:] }}</div>{% endif %}
  <details class="small"><summary class="muted">Why — the numbers the call used</summary><ul style="margin:6px 0 0;padding-left:18px">{% for r in s.rationale %}<li>{{ r|plain_sector_line }} <span class="muted">— {{ r }}</span></li>{% endfor %}</ul></details>
</div>{% endfor %}
</div>
{% set ai = sector_calls|selectattr('sector', 'in', ['ai_chips','ai_infrastructure','ai_applications','ai_models','ai_energy'])|list %}{% set en = sector_calls|selectattr('sector', 'equalto', 'energy')|list %}
<div class="card" style="border-left:4px solid var(--s2)"><b>The barbell</b> <span class="muted small">(Paul: oil and tech are the two ends)</span>
  <div class="small" style="margin-top:4px"><b>Tech end:</b> {% for s in ai %}{{ s.label.split(' — ')[0] }} {{ s.stance }}{% if s.bet %} ({{ '%+.1f pp'|format(s.bet.active_bet_pp) }}){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  <div class="small" style="margin-top:2px"><b>Oil end:</b> {% for s in en %}Energy {{ s.stance }}{% if s.bet %} ({{ '%+.1f pp'|format(s.bet.active_bet_pp) }}){% endif %}{% if s.cycle_read %} — {{ s.cycle_read.verdict }}{% endif %}{% else %}no energy call{% endfor %}</div>
</div>
<div class="small muted" style="margin:0 0 8px">Stance thresholds and weights are hypotheses (D-58 / D-27). Slots go to sectors by stance first; the best Idea Strength inside each sector fills them; no slot goes to an "avoid" sector. Bet = the sector's share of scored market cap × stance multiplier (overweight 1.5, neutral 1, underweight 0.5, avoid 0), renormalised, minus market weight. Cycle = the sector's theme in transcript breadth (live from 10% of calls; 25% off peak for two quarters is the exit signal, D-24).</div>
{% endif %}
<div class="filters">
  <label>Region <select id="f-region"><option value="">all</option>{% for r in regions %}<option>{{ r }}</option>{% endfor %}</select></label>
  <label>Sector <select id="f-sector"><option value="">all</option>{% for s in sectors %}<option>{{ s }}</option>{% endfor %}</select></label>
  <label>Action <select id="f-action"><option value="">all</option><option>buy-in-stages</option><option>watch</option><option>pass</option></select></label>
  <label>Asset type <select id="f-asset"><option value="">all</option>{% for a in asset_types %}<option>{{ a }}</option>{% endfor %}</select></label>
  <label><input type="checkbox" id="f-onsale"> on sale only (≥50)</label>
  <label>Sort <select id="f-sort"><option value="strength">Strength</option><option value="rank">Rank</option>{% for a in angle_keys %}<option value="{{ a }}">{{ angle_short[a] }}</option>{% endfor %}<option value="kelly">Kelly</option><option value="mcap">Mkt cap</option><option value="pe">P/E</option><option value="pe_pct">P/E own pct</option><option value="growth">Rev growth</option><option value="symbol">Name</option></select></label>
  <label>Rows <select id="f-rows"><option>20</option><option>50</option><option selected>{{ n_scored }}</option></select></label>
</div>
<div id="board">
{% for c in ideas %}
<div class="card idea" data-region="{{ c.region }}" data-sector="{{ c.sector }}" data-action="{{ c.action }}" data-asset="{{ c.asset_type }}" data-onsale="{{ c.angle_map.on_sale or 0 }}"
     data-rank="{{ c.rank or 9999 }}" data-symbol="{{ c.symbol }}" data-strength="{{ c.idea_strength or 0 }}" data-kelly="{{ c.kelly_weight or 0 }}" data-mcap="{{ c.market_cap or 0 }}" data-pe="{{ c.metrics.pe_ttm or 0 }}" data-pe_pct="{{ c.metrics.pe_own_pctile if c.metrics.pe_own_pctile is not none else -1 }}" data-growth="{{ c.metrics.rev_growth_ttm if c.metrics.rev_growth_ttm is not none else -9 }}"{% for a in angle_keys %} data-{{ a }}="{{ c.angle_map[a] or 0 }}"{% endfor %}>
  <div class="idea-head">
    <span class="rank">#{{ c.rank }}</span>
    <span class="name"><a href="ideas/{{ c.symbol }}.html"><b>{{ c.symbol }}</b></a> <span class="muted">{{ c.name|truncate(40) }}</span></span>
    <span class="badge {{ 'buy' if c.action=='buy-in-stages' else c.action }}">{{ c.action }}</span>
    <span class="stat"><b>{{ '%.0f'|format(c.idea_strength or 0) }}</b> <span class="muted small">strength</span></span>
    <span class="stat"><b>{{ '%.1f%%'|format(c.kelly_weight*100) if c.kelly_weight is not none else '–' }}</b> <span class="muted small">Kelly</span></span>
    <span class="stat"><b>{{ c.mcap_fmt }}</b> <span class="muted small">cap</span></span>
    <span class="stat"><b>{{ '%.1f'|format(c.metrics.pe_ttm) if c.metrics.pe_ttm else '–' }}</b> <span class="muted small">P/E</span></span>
    <span class="stat"><b>{{ '%.0f'|format(c.metrics.pe_own_pctile) if c.metrics.pe_own_pctile is not none else '–' }}</b> <span class="muted small">own pct</span></span>
    <span class="stat"><b>{{ '%+.0f%%'|format(c.metrics.rev_growth_ttm*100) if c.metrics.rev_growth_ttm is not none else '–' }}</b> <span class="muted small">rev g</span></span>
  </div>
  <div class="small muted">{{ c.sector }} · theme sector <b>{{ sector_map.get(c.theme_sector).label if sector_map.get(c.theme_sector) else c.theme_sector }}</b> · {{ ASSET_WORDS.get(c.asset_type, c.asset_type) }}{% if c.ai_layer != "none" %} · {{ LAYER_WORDS.get(c.ai_layer, c.ai_layer) }}{% endif %}</div>
{% set sp = summary_parts(c, sector_map.get(c.theme_sector), c.kelly_weight) %}<div class="summary"><p class="thesis">{{ sp.thesis }}</p><ol>{% for r in sp.reasons %}<li>{{ r }}</li>{% endfor %}</ol><p class="recap">{{ sp.recap }}</p></div>
  {% if c.metrics.danoff %}<div class="small"><b>Danoff:</b> {{ c.metrics.danoff.verdict }} ({{ '%.0f'|format(c.metrics.danoff.score) }}/100){% if c.metrics.danoff.years_to_double %} · earnings double in {{ '%.1f'|format(c.metrics.danoff.years_to_double) }} years at the recent rate{% endif %} · {{ c.metrics.danoff.face }}.</div>{% endif %}
  <details class="evidence"><summary class="small muted">Show the evidence (angles, reasons with rule ids, gates)</summary>
  <div class="chips">{% for a in angle_keys %}<span class="chip" title="{{ angle_labels[a] }}">{{ angle_short[a] }} <b>{{ '%.0f'|format(c.angle_map[a]) if c.angle_map[a] is not none else '–' }}</b></span>{% endfor %}
    {% for g in c.gates if g.outcome != 'pass' %}<span class="badge gate" title="{{ g.evidence }}">{{ g.gate_id }} {{ g.outcome }}</span>{% endfor %}{% for x in c.excluded_by %}<span class="badge hard">{{ x }}</span>{% endfor %}{% for a in c.alerts %}<span class="badge alert" title="{{ a.message }}">{{ a.rule_id }}</span>{% endfor %}</div>
  <div class="idea-body">
    <div class="small reasons">{% for r in c.top_reasons %}<div><span class="{{ 'reason-pos' if r.contribution and r.contribution>0 else 'reason-neg' }}">{{ r.rule_id }}</span> {{ r.label|truncate(70) }}{% if r.value is not none %}: <b>{{ r.value_fmt }}</b>{% endif %}</div>{% endfor %}{% if c.decisions_touched %}<div class="muted">D-IDs: {{ c.decisions_touched|join(' ') }}</div>{% endif %}</div>
    <div class="spark" hidden></div>
  </div>
  </details>
  <div class="idea-body" style="grid-template-columns:1fr">
    <div class="spark">{% if c.chart_json %}<div id="{{ c.chart_id }}" class="chart" style="height:70px"></div><script type="application/json" id="spec-{{ c.chart_id }}">{{ c.chart_json|safe }}</script>{% else %}<span class="muted small">chart on idea page</span>{% endif %}</div>
  </div>
</div>
{% endfor %}
</div>
<style>
.sector-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 10px; }
.sector-card { margin:0; padding:10px 12px; min-width:0; } .sector-head { display:flex; flex-wrap:wrap; gap:6px 8px; align-items:baseline; }
.idea { padding:10px 14px; margin:8px 0; min-width:0; }
.idea-head { display:flex; flex-wrap:wrap; gap:6px 16px; align-items:baseline; } .idea-head .rank { color:var(--muted); min-width:36px; } .idea-head .name { min-width:200px; }
.idea-head .stat { white-space:nowrap; font-variant-numeric: tabular-nums; }
.summary { margin:6px 0 4px; font-size:15px; line-height:1.5; } .summary .thesis { margin:4px 0; font-weight:600; } .summary ol { margin:2px 0 4px; padding-left:22px; } .summary .recap { margin:2px 0; color:var(--ink2); }
.evidence summary { cursor:pointer; margin:2px 0 6px; }
.chips { display:flex; flex-wrap:wrap; gap:4px 6px; margin:6px 0; }
.chip { font-size:12px; padding:1px 7px; border-radius:6px; background:var(--page); border:1px solid var(--border); white-space:nowrap; }
.idea-body { display:grid; grid-template-columns: 1fr 260px; gap: 10px 18px; align-items:start; } .idea-body .reasons, .idea-body .spark { min-width:0; }
@media (max-width: 760px) { .idea-body { grid-template-columns: 1fr; } .idea-head .name { min-width:0; } }
</style>
{% if excluded %}
<details class="card"><summary>{{ excluded|length }} names excluded, vetoed or avoided (HARD rules / gates)</summary>
<table><thead><tr><th>Name</th><th>Would rank</th><th>Rule</th><th>Evidence</th></tr></thead><tbody>
{% for c in excluded %}<tr><td><a href="ideas/{{ c.symbol }}.html">{{ c.symbol }}</a> <span class="muted small">{{ c.name }}</span></td><td class="num">{{ c.rank or '–' }}</td><td>{{ c.excluded_by|join(', ') or (c.gates|selectattr('outcome','in',['veto','avoid'])|map(attribute='gate_id')|join(', ')) }}</td><td class="small">{{ c.action_reason }}</td></tr>{% endfor %}
</tbody></table></details>
{% endif %}

<details class="card small"><summary>Glossary — the terms on this page</summary><dl style="margin:8px 0 0">{% for term, text in GLOSSARY %}<dt><b>{{ term }}</b></dt><dd class="muted" style="margin:0 0 6px">{{ text }}</dd>{% endfor %}</dl></details>
<div class="card small muted">Methodology: universe = {{ universe_note }}. Factors are winsorized {{ winsor }}% and z-scored within region × date; each angle is the weighted mean of its factors, ranked to a 0–100 percentile; Idea Strength = preset-weighted blend of angles minus penalties. Names with factor coverage below {{ cov_min }} are not scored. Values marked <i>hypothesis</i> are stand-ins for TBD(Paul) parameters (INV-5) — see each idea page. This is decision support for Paul; nothing here is an order or a publication.</div>
{% endblock %}
{% block scripts %}
<script>
(function(){
  const board = document.getElementById('board');
  function rows(){ return Array.from(board.querySelectorAll('.idea')); }
  window.renderVisibleCharts = function(){
    if (!window.Plotly) return;
    for (const r of rows()){ if (r.hidden) continue; const ch = r.querySelector('.chart'); if (!ch) continue;
      if (!ch.classList.contains('js-plotly-plot')) { if (window.renderChart) window.renderChart(ch.id); } else { Plotly.Plots.resize(ch); } }
  };
  function applyFilters(){
    const reg = document.getElementById('f-region').value, sec = document.getElementById('f-sector').value, act = document.getElementById('f-action').value,
          ast = document.getElementById('f-asset').value, onsale = document.getElementById('f-onsale').checked, max = parseInt(document.getElementById('f-rows').value);
    let shown = 0;
    for (const r of rows()){
      const d = r.dataset;
      let ok = (!reg || d.region===reg) && (!sec || d.sector===sec) && (!act || d.action===act) && (!ast || d.asset===ast) && (!onsale || parseFloat(d.onsale)>=50);
      if (ok && shown>=max) ok = false;
      r.hidden = !ok; if (ok) shown++;
    }
    if (window.renderVisibleCharts) window.renderVisibleCharts();
  }
  function sortBy(k){
    const asc = (k==='symbol' || k==='rank');
    const rs = rows();
    rs.sort((a,b)=>{ const av=a.dataset[k], bv=b.dataset[k]; const an=parseFloat(av), bn=parseFloat(bv);
      const c = (!isNaN(an)&&!isNaN(bn)) ? (an-bn) : String(av).localeCompare(String(bv)); return asc ? c : -c; });
    for (const r of rs) board.appendChild(r);
    applyFilters();
  }
  for (const id of ['f-region','f-sector','f-action','f-asset','f-onsale','f-rows']) document.getElementById(id).addEventListener('change', applyFilters);
  document.getElementById('f-sort').addEventListener('change', e => sortBy(e.target.value));
  sortBy('strength');
})();
</script>
{% endblock %}
