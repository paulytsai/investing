{% extends "base.html.j2" %}
{% block nav %}<a href="../../index.html">runs</a> · backtest{% endblock %}
{% block content %}
<h1>Backtest — {{ params.region }} · {{ params.start }} → {{ params.end }} · top {{ params.top }} · {{ params.hold_label }}</h1>
<p class="sub">Quarterly overlapping cohorts scored point-in-time (only facts filed before each formation date), no trading inside the hold. Exit rule: <b>{{ params.hold_label }}</b>{% if params.exit_rule == 'cycle' %} — a pick is sold when its theme-sector cycle is judged over: the sector call has reversed (avoid, or two stance levels below the call at formation) at {{ params.cycle_k }} consecutive later quarterly evaluations, or the theme's transcript breadth (once it has reached 10% of calls) sits ≥{{ params.breadth_drop|int }}% below its trailing peak for {{ params.cycle_k }} quarters (D-24); otherwise held to {{ params.max_hold }} months. Positions still open are marked at the last close and flagged.{% endif %} Weights: equal weight and Kelly ({{ params.kelly.fraction }}× Kelly from the DCF scenarios and the trailing {{ params.kelly.lookback }}-day covariance, cap {{ params.kelly.cap_pct|int }}%, D-01) side by side. Preset <b>{{ params.preset }}</b>, universe <b>{{ params.universe_kind }}</b>. Benchmark: {{ params.bench_label }} over the same windows. Returns shown as <b>CAGR</b> and <b>simple annualized</b> (Paul's 年率 convention, spec §5.4) side by side.</p>

<div class="grid">
  <div class="card tile"><div class="label">Complete cohorts</div><div class="value">{{ pooled.cohorts or 0 }}</div><div class="delta">of {{ rows|length }} formed (in-flight excluded from pooled stats)</div></div>
  <div class="card tile"><div class="label">Mean cohort return (equal weight, mean hold {{ '%.1f'|format(pooled.mean_hold_years or 0) }}y)</div><div class="value">{{ '%+.1f%%'|format((pooled.mean_cohort_ret or 0)*100) }}</div><div class="delta">median {{ '%+.1f%%'|format((pooled.median_cohort_ret or 0)*100) }} · excess vs benchmark {{ '%+.1f%%'|format((pooled.mean_excess or 0)*100) }}{% if pooled.mean_excess_ew is not none %} · vs equal-weight S&P (RSP) {{ '%+.1f%%'|format(pooled.mean_excess_ew*100) }}{% endif %}</div></div>
  {% if pooled.mean_cohort_ret_kelly is not none %}<div class="card tile"><div class="label">Mean cohort return (Kelly weights)</div><div class="value">{{ '%+.1f%%'|format(pooled.mean_cohort_ret_kelly*100) }}</div><div class="delta">fully invested · with cash remainder {{ '%+.1f%%'|format((pooled.mean_cohort_ret_kelly_cash or 0)*100) }} (mean gross {{ '%.0f%%'|format((pooled.mean_kelly_gross or 0)*100) }}) · excess vs benchmark {{ '%+.1f%%'|format((pooled.mean_excess_kelly or 0)*100) }} · Kelly beats equal weight in {{ '%.0f%%'|format((pooled.share_kelly_beats_ew or 0)*100) }} of cohorts</div></div>{% endif %}
  <div class="card tile"><div class="label">Batting average (F-119)</div><div class="value">{{ '%.0f%%'|format((pooled.mean_batting_beat or 0)*100) }}</div><div class="delta">picks beating benchmark · {{ '%.0f%%'|format((pooled.mean_batting_pos or 0)*100) }} positive · cohorts beating: {{ '%.0f%%'|format((pooled.share_cohorts_beating or 0)*100) }}{% if pooled.mean_batting_beat_ew is not none %} · vs RSP: picks {{ '%.0f%%'|format(pooled.mean_batting_beat_ew*100) }}, cohorts {{ '%.0f%%'|format((pooled.share_cohorts_beating_ew or 0)*100) }}{% endif %}</div></div>
  {% if cstats %}<div class="card tile"><div class="label">Overlapping portfolio {{ cstats.start }} → {{ cstats.end }}</div><div class="value">{{ '%+.1f%%'|format(cstats.portfolio.cagr*100) }} <span class="small muted">CAGR</span></div><div class="delta">simple {{ '%+.1f%%'|format(cstats.portfolio.simple*100) }}/yr · benchmark CAGR {{ '%+.1f%%'|format(cstats.benchmark.cagr*100) }} (simple {{ '%+.1f%%'|format(cstats.benchmark.simple*100) }}) · max DD {{ '%.0f%%'|format(cstats.max_dd*100) }} vs {{ '%.0f%%'|format(cstats.bench_max_dd*100) }} · vol {{ '%.0f%%'|format(cstats.vol*100) }} vs {{ '%.0f%%'|format(cstats.bench_vol*100) }}{% if cstats.beta %} · beta {{ '%.2f'|format(cstats.beta) }}{% endif %}</div></div>{% endif %}
</div>

{% if curve_json %}<div class="card"><div id="curve" class="chart" style="height:320px"></div><script type="application/json" id="spec-curve">{{ curve_json|safe }}</script>
<div class="small muted">Headline statistics start when {{ params.n_sleeves }} cohorts are live; earlier dates are the ramp. Capital is split equally across live cohorts; inside a cohort a pick's proceeds sit in cash after its exit.{% if cstats_k and cstats_k.portfolio %} Kelly-weighted portfolio: {{ '%+.1f%%'|format(cstats_k.portfolio.cagr*100) }} CAGR / {{ '%+.1f%%'|format(cstats_k.portfolio.simple*100) }} simple over the same window (cash remainder earns 0).{% endif %}</div></div>{% endif %}
{% if pooled_open and pooled_open.n_open_positions %}<div class="card small"><b>Including open positions</b> (marked at the last close, {{ pooled_open.n_open_positions }} positions across {{ pooled_open.cohorts }} cohorts): mean cohort return {{ '%+.1f%%'|format((pooled_open.mean_cohort_ret or 0)*100) }} equal weight, {{ '%+.1f%%'|format((pooled_open.mean_cohort_ret_kelly or 0)*100) }} Kelly; excess vs benchmark {{ '%+.1f%%'|format((pooled_open.mean_excess or 0)*100) }}. The pooled tiles above count only cohorts whose every position has closed.</div>{% endif %}
{% if cohort_json %}<div class="card"><div id="cohorts" class="chart" style="height:260px"></div><script type="application/json" id="spec-cohorts">{{ cohort_json|safe }}</script></div>{% endif %}

{% if cstats and cstats.calendar_years %}
{% if pooled.mean_excess_vs_sector is not none %}
<h2>Sector call first — sector-adjusted results (R-23 / F-39)</h2>
<div class="card"><div>Mean pick excess vs <b>its own theme sector</b> (equal-weight of every eligible member over the same window): <b>{{ '%+.1f%%'|format(pooled.mean_excess_vs_sector*100) }}</b> · picks beating their sector {{ '%.0f%%'|format((pooled.mean_batting_beat_sector or 0)*100) }} · Brinson vs the equal-weight eligible universe: <b>allocation {{ '%+.1f%%'|format((pooled.mean_allocation or 0)*100) }}</b> (the sector calls) · <b>selection {{ '%+.1f%%'|format((pooled.mean_selection or 0)*100) }}</b> (the names inside sectors), per cohort.</div>
<table style="margin-top:10px"><thead><tr><th>Theme sector</th><th class="num">Picks</th><th class="num">Mean pick return</th><th class="num">Sector (EW eligible)</th><th class="num">Excess</th><th>Stances over cohorts</th></tr></thead><tbody>
{% for s in pooled.sector_summary %}<tr><td>{{ s.sector }}</td><td class="num">{{ s.picks }}</td><td class="num">{{ '%+.1f%%'|format(s.mean_pick_ret*100) if s.mean_pick_ret is not none else '–' }}</td><td class="num">{{ '%+.1f%%'|format(s.mean_sector_ret*100) if s.mean_sector_ret is not none else '–' }}</td><td class="num">{{ '%+.1f%%'|format((s.mean_pick_ret - s.mean_sector_ret)*100) if s.mean_pick_ret is not none and s.mean_sector_ret is not none else '–' }}</td><td class="small">{{ s.stances }}</td></tr>{% endfor %}
</tbody></table></div>
{% endif %}
<h2>Calendar years (overlapping portfolio)</h2>
<div class="card"><table><thead><tr><th>Year</th><th class="num">Engine</th><th class="num">Benchmark</th><th class="num">Excess</th></tr></thead><tbody>
{% for y in cstats.calendar_years %}<tr><td>{{ y.year }}</td><td class="num">{{ '%+.1f%%'|format(y.portfolio*100) }}</td><td class="num">{{ '%+.1f%%'|format(y.benchmark*100) if y.benchmark == y.benchmark else '–' }}</td><td class="num">{{ '%+.1f%%'|format((y.portfolio - y.benchmark)*100) if y.benchmark == y.benchmark else '–' }}</td></tr>{% endfor %}
</tbody></table></div>
{% endif %}

<h2>Which angles predicted returns? (Spearman rank-IC, all eligible names per cohort; Newey–West t)</h2>
<div class="card"><table><thead><tr><th>Angle</th><th class="num">Mean IC</th><th class="num">Hit rate (IC&gt;0)</th><th class="num">t (NW)</th><th class="num">Cohorts</th></tr></thead><tbody>
{% for k, v in ic.items() %}<tr><td>{{ angle_labels.get(k, k) }}</td><td class="num">{{ '%.3f'|format(v.mean_ic) if v.mean_ic is not none else '–' }}</td><td class="num">{{ '%.0f%%'|format(v.hit_rate*100) if v.hit_rate is not none else '–' }}</td><td class="num">{{ '%.2f'|format(v.t_nw) if v.t_nw is not none else '–' }}</td><td class="num">{{ v.n }}</td></tr>{% endfor %}
</tbody></table><div class="small muted">Positive IC = higher angle score preceded higher {{ params.hold_months }}-month return. Cohorts overlap, so the naive t-stat is inflated; the NW lag-7 version is shown.</div></div>

{% if sens %}
<h2>Sensitivity — evidence for the TBD(Paul) decisions (D-24 exit rule, D-01 sizing, D-27 weights, D-08 name count)</h2>
<div class="card"><table><thead><tr><th>Variant</th><th>Exit</th><th class="num">Cohorts</th><th class="num">Mean hold</th><th class="num">Mean cohort return (EW)</th><th class="num">Kelly</th><th class="num">Mean excess (EW)</th><th class="num">Kelly</th><th class="num">Cohorts beating</th><th class="num">Batting (beat)</th></tr></thead><tbody>
{% for s in sens %}<tr><td>{{ s.label }}</td><td class="small">{{ s.exit }}</td><td class="num">{{ s.cohorts }}</td><td class="num">{{ '%.1f'|format(s.mean_hold_years or 0) }}y</td><td class="num">{{ '%+.1f%%'|format((s.mean_cohort_ret or 0)*100) }}</td><td class="num">{{ '%+.1f%%'|format(s.mean_cohort_ret_kelly*100) if s.mean_cohort_ret_kelly is not none else '–' }}</td><td class="num">{{ '%+.1f%%'|format((s.mean_excess or 0)*100) }}</td><td class="num">{{ '%+.1f%%'|format(s.mean_excess_kelly*100) if s.mean_excess_kelly is not none else '–' }}</td><td class="num">{{ '%.0f%%'|format((s.share_cohorts_beating or 0)*100) }}</td><td class="num">{{ '%.0f%%'|format((s.mean_batting_beat or 0)*100) }}</td></tr>{% endfor %}
</tbody></table></div>
{% endif %}

<h2>Cohorts</h2>
<div class="card" style="overflow-x:auto"><table><thead><tr><th>Formation</th><th class="num">Scored / eligible</th><th class="num">Picks</th><th class="num">Mean return (EW)</th><th class="num">Kelly</th><th class="num">Hold</th><th class="num">CAGR</th><th class="num">Simple</th><th class="num">Benchmark</th><th class="num">Excess</th><th class="num">Batting (beat)</th><th>Best / worst</th><th>10Y · CPI at formation</th><th>Picks</th></tr></thead><tbody>
{% for r in rows %}<tr>
<td><a href="cohorts/{{ r.formation }}.html">{{ r.formation }}</a>{% if r.in_flight %} <span class="badge">open</span>{% endif %}</td>
<td class="num">{{ r.n_scored }} / {{ r.n_eligible }}</td><td class="num">{{ r.n or 0 }}{% if r.n_delisted %} <span class="badge alert" title="series ended inside the hold: exit at last close then cash">{{ r.n_delisted }} delisted</span>{% endif %}</td>
<td class="num">{{ '%+.1f%%'|format(r.ret_mean*100) if r.ret_mean is not none else '–' }}</td><td class="num">{{ '%+.1f%%'|format(r.ret_kelly*100) if r.ret_kelly is not none else '–' }}</td><td class="num">{{ '%.1f'|format(r.hold_years) + 'y' if r.hold_years else '–' }}{% if r.n_open %} <span class="badge" title="positions still open, marked at the last close">{{ r.n_open }} open</span>{% endif %}</td><td class="num">{{ '%+.1f%%'|format(r.cagr*100) if r.cagr is not none else '–' }}</td><td class="num">{{ '%+.1f%%'|format(r.simple*100) if r.simple is not none else '–' }}</td>
<td class="num">{{ '%+.1f%%'|format(r.bench_ret*100) if r.bench_ret is not none else '–' }}</td><td class="num {{ 'reason-pos' if r.excess and r.excess>0 else 'reason-neg' }}">{{ '%+.1f%%'|format(r.excess*100) if r.excess is not none else '–' }}</td>
<td class="num">{{ '%.0f%%'|format(r.batting_beat*100) if r.batting_beat is not none else '–' }}</td><td class="small">{{ r.best }} / {{ r.worst }}</td>
<td class="small">{{ r.macro.get('10Y UST', '–') }} · {{ r.macro.get('CPI YoY', '–') }}</td><td class="small">{{ r.picks|join(' ') }}</td></tr>{% endfor %}
</tbody></table></div>
<div class="card small muted">Method: formation = quarter-end; entry = first trading day after; exit = {{ 'the cycle rule above (min ' ~ params.min_hold ~ 'm, max ' ~ params.max_hold ~ 'm)' if params.exit_rule == 'cycle' else 'last trading day within ' ~ params.hold_months ~ ' months' }}; equal weight and Kelly weights (per-name scenario Kelly from growth-path × multiple-path scenarios — 3y revenue CAGR under the R-24 ceiling, P/E moving to the own-history band — bear floored at −1σ·√H of the name's own trailing volatility; portfolio Kelly w* = Σ⁻¹(μ − r_f) on the trailing {{ params.kelly.lookback }}-day covariance with {{ params.kelly.shrink }} shrinkage; {{ params.kelly.fraction }}× Kelly × confidence, per-name cap {{ params.kelly.cap_pct|int }}%, no leverage, remainder cash; r_f = 10Y UST at formation); total-return closes; a name whose price series ends inside the hold is exited at its last close and held as cash (flagged). Hypothesis parameters (INV-5) that shaped these results: {{ decisions|join(', ') }}. Decision support only.</div>
{% endblock %}
