# Copy to .env and fill in. Variables set in the real environment win over this file.

# --- basics ---
OWNER_EMAIL=you@example.com            # the only account that can sign in until a display licence is recorded
BASE_URL=http://localhost:8787         # public origin: cookies, email links, Stripe return URLs
PORT=8787
# DATA_DIR=data                        # SQLite database and backups
# NODE_ENV=production                  # turns on secure cookies, turns off the dev outbox and mock billing
# SESSION_DAYS=30
# TRUST_PROXY=1                        # number of reverse proxies in front that append X-Forwarded-For (0 = none)
# REQUIRE_ADMIN_MFA=true               # admins need an authenticator code to open /admin

# --- email (sign-in codes) ---
# Without a key, codes go to the dev outbox: printed in the server log and listed at /dev/mail (localhost only).
RESEND_API_KEY=
MAIL_FROM=Company model <no-reply@yourdomain.example>

# --- data ---
FMP_API_KEY=                           # Financial Modeling Prep (stable API)
# FMP_FIXTURES=                        # tests: serve saved payloads instead of calling FMP
EDGAR_TOOLS_API_KEY=                   # Edgar Tools (app.edgar.tools); without it, filings come straight from sec.gov
# Required without EDGAR_TOOLS_API_KEY: www.sec.gov refuses anonymous clients. "<app or company name> <contact email>",
# e.g. "Company Model ops@yourdomain.example"
SEC_USER_AGENT=

# --- Claude ---
# Without a key, Claude features answer from a clearly labelled stub.
ANTHROPIC_API_KEY=
# CLAUDE_BASE_URL=https://api.anthropic.com   # change only for an API gateway (the app ignores ANTHROPIC_BASE_URL)

# --- billing (stays off until the licences are recorded and you switch it on in /admin → Settings) ---
STRIPE_SECRET_KEY=                     # sk_test_… while testing
STRIPE_WEBHOOK_SECRET=                 # whsec_… from the Stripe dashboard or `stripe listen` (comma-separate two while rotating)
