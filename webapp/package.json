{
  "name": "company-model-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "Company model web app: the claude.ai artifact page served with accounts, an admin area and billing",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "build": "python3 ../templates/build.py --web",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0"
  }
}
