# Copy this file to .env and fill in your real keys.
# .env is gitignored and must never be committed.

# --- Market data providers ---
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=            # Financial Modeling Prep
TIINGO_API_KEY=
EODHD_API_KEY=
JQUANTS_API_KEY=        # J-Quants (JPX) v2 API key

# --- Macro / fundamentals ---
FRED_API_KEY=           # St. Louis Fed economic data
SEC_USER_AGENT=         # e.g. "Your Name your@email.com" (required by SEC EDGAR)

# --- News / sentiment ---
NEWS_API_KEY=

# --- Brokerage ---
# Interactive Brokers (Client Portal / TWS API)
IBKR_ACCOUNT_ID=
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 = TWS paper, 7496 = TWS live, 4002/4001 = IB Gateway
IBKR_CLIENT_ID=1
# Alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- LLM ---
ANTHROPIC_API_KEY=
