# Copy to .env (gitignored) or set as environment secrets. One key per line, nothing after the value.
# FMP (Ultimate): fundamentals, prices, transcripts, 13F, bulk. Alpaca: market data only, never trading.
# J-Quants v2 (x-api-key): Japan. EDINET v2: Japanese filings. FRED: macro series. Anthropic: optional narrative layer.
FMP_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
JQUANTS_API_KEY=
EDINET_API_KEY=
FRED_API_KEY=
ANTHROPIC_API_KEY=
