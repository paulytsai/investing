# Copy to .env (gitignored) or set as environment secrets. Names only; never commit values.
FMP_API_KEY=            # Financial Modeling Prep (Ultimate): fundamentals, prices, transcripts, 13F, bulk
ALPACA_API_KEY=         # Alpaca market data only (data.alpaca.markets); no trading endpoints are ever called
ALPACA_SECRET_KEY=
JQUANTS_API_KEY=        # J-Quants v2 (x-api-key): Japan prices, 決算短信 summaries, master, TOPIX
EDINET_API_KEY=         # EDINET v2 Subscription-Key: Japanese filings (有価証券報告書)
FRED_API_KEY=           # FRED: DGS10, DTB3, CPIAUCSL, DEXJPUS (macro dashboard, hurdle rate)
ANTHROPIC_API_KEY=      # Optional: Claude narrative layer (thesis, four lenses, phase explanations)
