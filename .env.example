# Copy this file to .env and fill in your real keys.
# .env is gitignored and must never be committed.

# --- Market data providers ---
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=            # Financial Modeling Prep
MARKET_DATA_PROVIDER=fmp # adapter in netlify/lib/providers (see providers/CONTRACT.md to add one)
TIINGO_API_KEY=
EODHD_API_KEY=
JQUANTS_API_KEY=        # J-Quants (JPX) v2 API key

# --- Macro / fundamentals ---
FRED_API_KEY=           # St. Louis Fed economic data
SEC_USER_AGENT=         # e.g. "Your Name your@email.com" (required by SEC EDGAR)

# --- News / sentiment ---
NEWS_API_KEY=
X_BEARER_TOKEN=         # X (Twitter) API v2 app bearer token

# --- Brokerage ---
# Interactive Brokers (Client Portal / TWS API)
IBKR_ACCOUNT_ID=
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 = TWS paper, 7496 = TWS live, 4002/4001 = IB Gateway
IBKR_CLIENT_ID=1
# Alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- LLM ---
ANTHROPIC_API_KEY=

# ===================== Web app (Netlify) =====================
# Which UI languages this deployment offers (first = default). Japanese site: "ja,en".
# Traditional Chinese site (separate Netlify site, same repo): "zh-TW,en".
SITE_LOCALES=ja,en
SITE_DEFAULT_LOCALE=ja
SITE_URL=                 # e.g. https://example.netlify.app (Netlify also provides URL automatically)
AUTH_SECRET=              # long random string; signs session cookies. `openssl rand -hex 32`
INTERNAL_SECRET=          # optional; protects the background summary function (defaults to AUTH_SECRET)
TRIAL_DAYS=7
PRICE_LABEL=US$10         # the amount as shown (no period; the UI adds "per month"): "¥1,500", "NT$300", "US$10"
PRICE_AMOUNT=10           # numeric price for structured data (matches the Lemon Squeezy variant)
PRICE_CURRENCY=USD        # the store's currency: USD, JPY or TWD. One Lemon Squeezy store per currency.
EDGAR_TOOLS_API_KEY=      # https://app.edgar.tools (Settings > API Keys), key starts with etk_
SUMMARY_MODEL=claude-opus-5-5

# Stripe Billing (preferred). One Stripe account, one monthly price per edition in its own
# currency (JPY for Kabukaizu, TWD for Guhaitu, USD for the US edition). Activate Managed
# Payments in the Stripe dashboard so Stripe is the merchant of record and handles tax.
STRIPE_SECRET_KEY=        # sk_live_... or sk_test_... (Developers > API keys)
STRIPE_PRICE_ID=          # price_... of this site's monthly price
STRIPE_PRICE_ID_ANNUAL=   # optional price_... of the yearly price (same product); enables the annual option
PRICE_AMOUNT_ANNUAL=      # yearly amount in the site's currency (26550 for the 25%-off yen plan)
PRICE_LABEL_ANNUAL=       # yearly amount as shown ("¥26,550")
STRIPE_WEBHOOK_SECRET=    # whsec_... of the endpoint https://<site>/api/webhooks/stripe
STRIPE_MANAGED_PAYMENTS=1 # 0 to charge as your own merchant (Stripe Tax or no tax handling)

# Lemon Squeezy (legacy; used only when the Stripe variables are not set)
LEMONSQUEEZY_STORE=       # store subdomain, e.g. "mystore" for mystore.lemonsqueezy.com
LEMONSQUEEZY_VARIANT_ID=2220324  # variant id of the US$10/month subscription product
LEMONSQUEEZY_CHECKOUT_URL= # optional: a full "buy" link instead of STORE + VARIANT_ID
LEMONSQUEEZY_WEBHOOK_SECRET= # signing secret entered when creating the webhook
LEMONSQUEEZY_API_KEY=     # optional; used to mint fresh customer-portal links

# Pre-generation (warmer): an hourly scheduled function refreshes data and generates
# missing AI commentary for the S&P 100 in English plus this site's locales.
WARM_PER_RUN=8            # new English generations per shard per hourly run (~US$0.60 each at high effort)
WARM_SHARDS=4             # background functions per hourly run (each handles 1/N of the universe)
WARM_FULL_SHARDS=10       # shards for "generate everything missing now" (admin panel)
WARM_CONCURRENCY=2        # tickers generated in parallel inside one shard
WARM_SYMBOLS=             # extra tickers to keep warm, comma-separated
SITE_BRAND=kabukaizu      # "kabukaizu" (株海図), "guhaitu" (股海圖) or "usstockalmanac" (English only); defaults from SITE_DEFAULT_LOCALE
# A second edition can read the market-data cache, AI commentary and generation jobs
# from the main site's Netlify Blobs instead of regenerating them (see README).
SHARED_BLOBS_SITE_ID=     # Netlify Site ID of the Kabukaizu site
SHARED_BLOBS_TOKEN=       # Netlify personal access token

# Built-in accounts (free forever). Set the passwords here, not in code.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=           # admin role: never pays, sees /#/admin usage panel
FRIEND_USERNAME=Friend
FRIEND_PASSWORD=          # complimentary member: never pays
WARM_PACE_MS=0            # optional pause after each English generation (ms), for tight rate limits

# Transactional email for password resets (Resend: https://resend.com). Without these,
# reset requests still work: the admin panel lists the pending reset links to send by hand.
RESEND_API_KEY=
MAIL_FROM=               # e.g. "Kabukaizu <noreply@your-domain>" on the Resend-verified domain
CONTACT_TO=               # where contact-form messages are emailed (defaults to the MAIL_FROM address)

# Model used to translate English reports into the other languages (default claude-sonnet-5-5)
TRANSLATION_MODEL=claude-sonnet-5-5
